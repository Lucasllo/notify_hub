{
  "uid": "notify-hub",
  "title": "Notify Hub",
  "description": "Notificações multicanal: aceitas pela API, entregues pelo worker, retries, DLQs, circuit breaker e JVM",
  "tags": ["notify-hub"],
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "timepicker": {},
  "timezone": "browser",
  "annotations": { "list": [] },
  "templating": { "list": [] },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Visão geral",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Throughput: aceitas pela API x entregues pelo worker",
      "description": "Aceitas = POST /notifications com 202 na API. Entregues = envios simulados com sucesso no worker.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"api\",method=\"POST\",uri=\"/notifications\",status=\"202\"}[$__rate_interval]))",
          "legendFormat": "aceitas (API)"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(notify_delivery_outcomes_total{outcome=\"sent\"}[$__rate_interval]))",
          "legendFormat": "entregues (worker)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Aceitas na janela",
      "description": "POST /notifications respondidos com 202 dentro da janela do dashboard.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 12, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "blue" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(http_server_requests_seconds_count{job=\"api\",method=\"POST\",uri=\"/notifications\",status=\"202\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Entregues na janela",
      "description": "Envios simulados com sucesso (outcome sent) dentro da janela do dashboard.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 16, "y": 1 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "color": { "mode": "fixed", "fixedColor": "green" } },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(notify_delivery_outcomes_total{outcome=\"sent\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 5,
      "type": "stat",
      "title": "Taxa de sucesso",
      "description": "Entregues sobre o total de desfechos terminais no worker (sent, failed e dead_lettered) dentro da janela.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 4, "x": 20, "y": 1 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 1,
          "min": 0,
          "max": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 0.7 },
              { "color": "green", "value": 0.9 }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(increase(notify_delivery_outcomes_total{outcome=\"sent\"}[$__range])) / sum(increase(notify_delivery_outcomes_total{outcome=~\"sent|failed|dead_lettered\"}[$__range]))",
          "instant": true
        }
      ]
    },
    {
      "id": 6,
      "type": "row",
      "title": "Entrega por canal",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
      "panels": []
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Resultados por canal e outcome",
      "description": "Desfechos de cada tentativa no worker: sent, retrying (falha transitória que vai para o próximo nível), dead_lettered (esgotou os níveis) e failed (falha permanente).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (channel, outcome) (rate(notify_delivery_outcomes_total[$__rate_interval]))",
          "legendFormat": "{{channel}} {{outcome}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "p95 do envio simulado por canal",
      "description": "Percentil 95 da duração do adapter simulado (latência configurada mais o processamento).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, channel) (rate(notify_delivery_duration_seconds_bucket[$__rate_interval])))",
          "legendFormat": "{{channel}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "row",
      "title": "Retry e DLQ",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 18 },
      "panels": []
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Retries por nível",
      "description": "No profile demo: nível 1 = 1s, nível 2 = 5s, nível 3 = 25s",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (level) (rate(notify_delivery_retries_total[$__rate_interval]))",
          "legendFormat": "nível {{level}}"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Filas de delay (mensagens)",
      "description": "Mensagens esperando o TTL de cada nível de retry (notify.<canal>.retry.<ttl>). Ao expirar, voltam para a fila principal do canal.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (queue) (rabbitmq_detailed_queue_messages{queue=~\"notify[.].+[.]retry[.].+\"})",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 12,
      "type": "timeseries",
      "title": "DLQs (mensagens)",
      "description": "Mensagens paradas nas DLQs (notify.<canal>.dlq): falhas permanentes e retries esgotados. Reprocessáveis por POST /admin/dlq/{canal}/reprocess.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (queue) (rabbitmq_detailed_queue_messages{queue=~\"notify[.].+[.]dlq\"})",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 13,
      "type": "timeseries",
      "title": "Filas principais (mensagens)",
      "description": "Backlog das filas de consumo de cada canal (notify.email, notify.sms, notify.webhook).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 19 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (queue) (rabbitmq_detailed_queue_messages{queue=~\"notify[.](email|sms|webhook)\"})",
          "legendFormat": "{{queue}}"
        }
      ]
    },
    {
      "id": 14,
      "type": "row",
      "title": "Resiliência",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 27 },
      "panels": []
    },
    {
      "id": 15,
      "type": "state-timeline",
      "title": "Circuit breaker por canal",
      "description": "Estado do circuit breaker (Resilience4j) de cada canal: verde = fechado, vermelho = aberto, amarelo = half-open. No demo o CB fica aberto só 500ms, então o gauge quase sempre é coletado em half-open; o painel de recusas ao lado mostra cada abertura.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 10, "x": 0, "y": 28 },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "fixed", "fixedColor": "text" },
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null } ] },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "index": 0, "text": "Fechado", "color": "green" },
                "1": { "index": 1, "text": "Aberto", "color": "red" },
                "2": { "index": 2, "text": "Half-open", "color": "yellow" }
              }
            }
          ],
          "custom": { "fillOpacity": 80, "lineWidth": 0 }
        },
        "overrides": []
      },
      "options": {
        "mergeValues": true,
        "showValue": "auto",
        "alignValue": "center",
        "rowHeight": 0.85,
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "single", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max by (name) (resilience4j_circuitbreaker_state{state=\"open\"}) + 2 * max by (name) (resilience4j_circuitbreaker_state{state=\"half_open\"})",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 16,
      "type": "timeseries",
      "title": "Recusas por segundo (CB aberto / bulkhead cheio)",
      "description": "Chamadas recusadas antes de chegar ao adapter. O CB do demo fica aberto 500ms e o Prometheus coleta a cada 5s, então o gauge da linha do tempo quase nunca pega o estado OPEN; estes contadores não perdem nenhum evento entre um scrape e outro. Cada recusa é tratada como falha transitória e consome um nível de retry.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 10, "y": 28 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (channel, reason) (rate(notify_delivery_rejections_total[$__rate_interval]))",
          "legendFormat": "{{channel}} {{reason}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (name) (rate(resilience4j_circuitbreaker_not_permitted_calls_total[$__rate_interval]))",
          "legendFormat": "{{name}} não permitidas (Resilience4j)"
        }
      ]
    },
    {
      "id": 17,
      "type": "timeseries",
      "title": "Bulkhead em uso",
      "description": "Chamadas concorrentes ocupando o bulkhead (semáforo) de cada canal.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 28 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "resilience4j_bulkhead_max_allowed_concurrent_calls - resilience4j_bulkhead_available_concurrent_calls",
          "legendFormat": "{{name}}"
        }
      ]
    },
    {
      "id": 18,
      "type": "row",
      "title": "API e JVM",
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 36 },
      "panels": []
    },
    {
      "id": 19,
      "type": "timeseries",
      "title": "POST /notifications por status",
      "description": "Taxa de respostas do POST /notifications por código HTTP (202 aceita, 400 inválida).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 37 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (status) (rate(http_server_requests_seconds_count{job=\"api\",method=\"POST\",uri=\"/notifications\"}[$__rate_interval]))",
          "legendFormat": "HTTP {{status}}"
        }
      ]
    },
    {
      "id": 20,
      "type": "timeseries",
      "title": "p95 de POST /notifications",
      "description": "Percentil 95 da latência do POST /notifications (validação, gravação no Mongo e publish com confirm).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 37 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "fillOpacity": 0, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"api\",method=\"POST\",uri=\"/notifications\"}[$__rate_interval])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Resultado do publish (confirm do broker)",
      "description": "Publicações da API por resultado: confirmed (ack do broker; reason claimed quando veio da varredura) ou publish_failed por motivo (nack, returned, timeout, broker_unavailable, unconfirmed).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 37 },
      "fieldConfig": {
        "defaults": { "unit": "ops", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (outcome, reason) (rate(notify_publish_outcomes_total[$__rate_interval]))",
          "legendFormat": "{{outcome}} / {{reason}}"
        }
      ]
    },
    {
      "id": 22,
      "type": "timeseries",
      "title": "Threads de plataforma vivas",
      "description": "Threads de plataforma vivas em cada JVM. Virtual threads não entram nesta contagem.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 45 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "custom": { "fillOpacity": 0, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job) (jvm_threads_live_threads{job=~\"api|worker\"})",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 23,
      "type": "timeseries",
      "title": "Heap usado",
      "description": "Memória heap usada por JVM (soma de todas as regiões).",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 45 },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "custom": { "fillOpacity": 10, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job) (jvm_memory_used_bytes{area=\"heap\",job=~\"api|worker\"})",
          "legendFormat": "{{job}}"
        }
      ]
    },
    {
      "id": 24,
      "type": "timeseries",
      "title": "Pool do MongoDB em uso",
      "description": "Conexões do driver do MongoDB em uso (checked out) por app.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 45 },
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "custom": { "fillOpacity": 0, "lineWidth": 2 } },
        "overrides": []
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom", "showLegend": true },
        "tooltip": { "mode": "multi", "sort": "none" }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (job) (mongodb_driver_pool_checkedout{job=~\"api|worker\"})",
          "legendFormat": "{{job}}"
        }
      ]
    }
  ]
}
