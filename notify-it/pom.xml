<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>dev.notifyhub</groupId>
        <artifactId>notify-hub-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>notify-it</artifactId>
    <packaging>jar</packaging>
    <name>Notify Hub :: IT</name>
    <description>Testes de integração: API e worker reais na mesma JVM contra RabbitMQ e MongoDB do Testcontainers</description>

    <!-- Módulo só de testes. As classes são *IT e rodam no Failsafe (integration-test/verify); não há
         nenhuma *Test, então "./mvnw test" continua sem Docker. Todas as versões vêm do BOM do Boot
         3.5.16 (Testcontainers 1.21.4) e do dependencyManagement do pai. -->
    <dependencies>
        <dependency>
            <groupId>dev.notifyhub</groupId>
            <artifactId>notify-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>dev.notifyhub</groupId>
            <artifactId>notify-worker</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>rabbitmq</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>mongodb</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Execuções integration-test e verify herdadas do spring-boot-starter-parent. As system
                 properties apontam o diretório de recursos de cada app: cada contexto lê o próprio
                 application.yml por spring.config.location (RESEARCH Padrão 9) -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <notify.it.api-config>${project.basedir}/../notify-api/src/main/resources/</notify.it.api-config>
                        <notify.it.worker-config>${project.basedir}/../notify-worker/src/main/resources/</notify.it.worker-config>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
